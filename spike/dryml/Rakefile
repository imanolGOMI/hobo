require "rake/testtask"

# The layer-3 runtime still lives in spike/. When it becomes the gem (step 4 of
# "Por donde seguir" in PLAN.md) this moves to dryml/Rakefile unchanged.
Rake::TestTask.new(:test) do |t|
  t.libs << "test" << "."
  t.test_files = FileList["test/**/*_test.rb"]
  t.warning = false
end

task :default => :test
