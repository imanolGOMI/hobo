class UserMailer < ApplicationMailer

  # The activation mail: a link with a one-use key in it.
  #
  # The key is the lifecycle's (`:new_key => true` on the signup step), it is
  # signed with the application's `secret_key_base`, and it stops working when
  # the step it belongs to has been taken.
  def activation(user, key)
    @user = user
    @url  = activate_url(user, :key => key)
    mail :subject => "Activate your account", :to => user.email_address
  end

end
