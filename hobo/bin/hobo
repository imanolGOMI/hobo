#!/usr/bin/env ruby
# `hobo new <app>` -- a plain `rails new` with Hobo wired in.
#
# It used to build a Rails application template on the fly, in a temp file, from
# a string. The template is a file in the gem now (lib/generators/hobo/
# app_template.rb), which means it can be read, reviewed and used on its own:
#
#   rails new blog -m $(gem which hobo)/../generators/hobo/app_template.rb

# **Este fichero se escribe en Ruby conservador a proposito.**
#
# `hobo update` se ejecuta dentro de la aplicacion que se va a actualizar, y esa
# aplicacion fija su version de Ruby -- 1.9.3 en una de Hobo 2. El interprete
# analiza el fichero **entero** antes de ejecutar una linea, asi que un `&.` o un
# heredoc con `~` no dan un aviso util: dan un error de sintaxis en la primera
# orden que alguien escribe de Hobo. Sin `&.` y sin `<<~`, el aviso de abajo
# llega a imprimirse.
if (RUBY_VERSION.split(".").map { |n| n.to_i } <=> [3, 2, 0]) < 0
  abort(
    "\nHobo 3 necesita Ruby 3.2 o mas; este es el #{RUBY_VERSION}.\n\n" +
    "Si estas dentro de una aplicacion vieja, es **su** Ruby el que manda.\n" +
    "Ejecutalo con el tuyo:\n\n" +
    "    RBENV_VERSION=3.4.6 hobo update\n\n" +
    "o desde fuera, diciendo cual es la aplicacion:\n\n" +
    "    hobo update mi_app\n\n"
  )
end

require "fileutils"

TEMPLATE = File.expand_path("../lib/generators/hobo/app_template.rb", __dir__)

# The questions the old setup wizard asked, as flags.
#
# They are Hobo's, not Rails', so they are taken out of the command line before
# `rails new` sees them -- an unknown flag there is an error -- and handed to the
# template through the environment. Without a flag the template asks, and with
# no terminal to ask in it takes the default.
#
# Las de lista van con `=` y comas -- `--locales=en,es`, `--plugins=jquery_ui` --
# y no separadas por espacios: aqui se decide bandera a bandera que es de Hobo y
# que es de `rails new`, y un valor suelto detras de una bandera no se distingue
# de un argumento de Rails.
HOBO_FLAGS = /\A--(no-)?(theme|activation-email|invite-only|private|admin|search|wizard|git)\z|\A--(locale|locales|front|admin-name|theme|behaviour|plugins)=|\A--(skip|generate)-migration\z/

command = ARGV.shift

case command
when "new"
  app = ARGV.shift
  abort("Falta el nombre de la aplicacion.\n\n  hobo new <app>\n") if app.nil?

  answers, rails_args = ARGV.partition { |argument| argument.match?(HOBO_FLAGS) }
  ENV["HOBO_NEW_ANSWERS"] = answers.join(" ")

  exec("rails", "new", app, "-m", TEMPLATE, *rails_args)
when "update"
  # `hobo update` -- traer una aplicacion de Hobo 2 a esta. Sin `--write` mira y
  # cuenta, que es lo primero que hace falta saber.
  require_relative "../lib/hobo/update"

  source = ARGV.find { |argument| !argument.start_with?("-") } || Dir.pwd
  write = ARGV.include?("--write")
  with_value = lambda do |flag, fallback|
    found = ARGV.grep(/\A--#{flag}=/).first
    found ? found.split("=", 2).last : fallback
  end
  name = with_value.call("as", nil)
  theme = with_value.call("theme", "clean")
  begin
    Hobo::Update.new(source, :write => write, :name => name, :theme => theme).run
  rescue Hobo::Update::Error
    exit 1
  end
when "version", "--version", "-v"
  puts File.read(File.expand_path("../VERSION", __dir__)).strip
else
  puts <<-USO.gsub(/^ {4}/, "")
    Hobo

      hobo new <app> [opciones]                Crea una aplicacion
      hobo update [<app>] [--write] [--theme=]  Trae una aplicacion de Hobo 2:
                                               sin --write mira y cuenta, con
                                               --write escribe <app>_hobo3 al
                                               lado, sin tocar la vieja.

    Opciones de Hobo (si no las pones, te pregunta):

      --theme=clean          El tema de Hobo: css propio, sin dependencias.
      --theme=none           Ni pagina ni estilos: Hobo pinta el cuerpo con sus
                             clases y tu layout lo envuelve.
      --theme=<nombre>       Cualquier otro tema que tengas instalado: la
                             pregunta los ofrece solos (p.ej. hobo_bootstrap
                             se responde --theme=bootstrap).
      --behaviour=<nombre>   Quien ejecuta el comportamiento de las paginas.
                             `stimulus` viene dentro; hobo_jquery se responde
                             --behaviour=jquery.
      --plugins=a,b          Los demas plugins que tengas instalados, p.ej.
                             --plugins=jquery_ui.
      --activation-email     El alta deja la cuenta apagada y manda un correo
                             con la clave para encenderla.
      --invite-only          No hay alta publica: un administrador invita.
      --private              Todo el sitio detras del login. Sin esto, cada
                             modelo decide quien ve sus paginas.
      --locales=en,es        Los idiomas de la aplicacion. Hobo trae sus
                             cadenas en ingles y en espanol.
      --locale=es            El idioma por defecto (y con el solo, el unico).
      --admin                Un subsitio de administracion en /admin.
      --no-search            Quitar la caja de busqueda de la barra, que por
                             defecto busca en todos los modelos del sitio.
      --front=home           Nombre del controlador de portada.
      --admin-name=staff     Nombre del subsitio de administracion.
      --skip-migration       No generar la migracion inicial (o
      --generate-migration   generarla sin ejecutarla).
      --git/--no-git         Dejar el trabajo del asistente en un commit.
      --wizard/--no-wizard   Preguntar siempre, o no preguntar nunca. Por
                             defecto pregunta si hay terminal.

    Para no inicializar git, pasale --skip-git, que es de `rails new`.

    El resto de opciones se le pasan tal cual a `rails new`.

    Dentro de una aplicacion:

      bin/rails generate hobo:resource <nombre> <campo:tipo>...
      bin/rails generate hobo:migration
      bin/rails generate authentication

    Con HOBODEV apuntando a un clon del repositorio, la aplicacion usa las
    gemas de ahi en vez de las publicadas.
  USO
  exit(command.nil? || command =~ /^--help|-h$/ ? 0 : 1)
end
