require "rake/testtask"

Rake::TestTask.new(:test) do |t|
  t.libs << "test" << "lib" << "../hobo_support/lib"
  t.test_files = FileList["test/**/*_test.rb"]
  t.warning = false
end

task :default => :test

# The old DRYML suites are kept, not run: the 87 cucumber scenarios of
# features/ and test/dryml.rdoctest describe the semantics the remix has to
# preserve, and they are read as the specification. See PLAN.md, layer 3.
